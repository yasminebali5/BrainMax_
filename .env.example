# Exemple des variables à définir dans votre terminal ou votre hébergeur.
SECRET_KEY=remplacez-cette-cle-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: configure PostgreSQL with DATABASE_URL or DB_NAME/DB_USER/DB_PASSWORD.
# Groq is preferred when configured; OpenRouter remains a compatible fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CHROMA_DB_PATH=.chroma
